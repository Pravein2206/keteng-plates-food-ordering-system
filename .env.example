# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Where to find them: Supabase dashboard > your project > Project Settings > API
# (step-by-step guide: docs/supabase-setup.md)

# Project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / public key ONLY. Never put the service_role (secret) key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
