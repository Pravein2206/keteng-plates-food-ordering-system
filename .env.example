# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Where to find them: Supabase dashboard > your project > Project Settings > API Keys
# (step-by-step guide: docs/supabase-setup.md)

# Project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key only (starts with sb_publishable_). It replaces the old "anon" key.
# Never put the secret (sb_secret_...) or service_role key in this app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
